def overlaps(a, b):
    return a[0] < b[1] and b[0] < a[1]

def fits(job, chosen):
    for c in chosen:
        if overlaps(job, c):
            return False
    return True

def greedy(jobs, keys):
    pairs = []
    for i in range(len(jobs)):
        pairs.append((keys[i], i))   
    pairs.sort()                     

    chosen = []
    for key, i in pairs:
        if fits(jobs[i], chosen):
            chosen.append(jobs[i])
    return chosen

def earliestFinish(jobs):
    keys = []
    for (s, f) in jobs:
        keys.append((f, s))          
    return greedy(jobs, keys)

def earliestStart(jobs):
    keys = []
    for (s, f) in jobs:
        keys.append((s, f))          
    return greedy(jobs, keys)

def shortestDuration(jobs):
    keys = []
    for (s, f) in jobs:
        keys.append((f - s, f, s))   
    return greedy(jobs, keys)

def earliestMidpoint(jobs):
    keys = []
    for (s, f) in jobs:
        keys.append((s + f, f, s))   
    return greedy(jobs, keys)

